{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoHtimer",
  "version": "0.1.3",
  "identifier": "com.pohtimer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PoHtimer",
        "width": 800,
        "height": 600,
        "minWidth": 780,
        "minHeight": 580,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "PoHtimer",
        "width": 420,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "transparent": true,
        "url": "splashscreen.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; font-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss:;"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://pohtimer.vercel.app/latest.json",
        "https://github.com/Virusilvester/pohtimer/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCRTA0NTkzMTU0NUU1MEIKUldRTDVVVVZrMFhnbXlWa1pVOHJYbG0yRGdzaEUxWVdoTS94TlFNZ3htZlhBSnZyRHoralVLL08K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com",
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
